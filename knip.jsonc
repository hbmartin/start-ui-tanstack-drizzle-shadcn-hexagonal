{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Seeds run through `node ./run-jiti`, which knip cannot trace from scripts.
      "entry": ["drizzle/seed/index.ts", "drizzle/seed/**/*.ts"],
    },
    "tools/mutation": {
      // The root runner and compatibility check resolve this isolated toolchain
      // through createRequire, which Knip does not model as a workspace edge.
      "ignoreDependencies": ["@typescript/native"],
    },
  },
  "ignoreDependencies": [
    // Manual copy-paste detection; configured via the "jscpd" key in package.json.
    "jscpd",
  ],
}
