    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "catching-jit-tests-vitest": "^0.4.0",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "^0.31.10",
    "fallow": "3.17.0",
    "jiti": "2.7.0",
    "lefthook": "2.1.9",
    "npm-run-all2": "9.0.3",
    "oxc-parser": "0.144.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.61.1",
    "ts-plugin-sort-import-suggestions": "1.0.4",
    "tsx": "^4.22.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0",
    "yaml": "2.9.0"
  },
  "resolutions": {
    "@types/node": "^24"
  },
  "engines": {
    "node": "24.x"
  },
