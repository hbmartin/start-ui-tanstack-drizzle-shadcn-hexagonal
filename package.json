    "input-otp": "1.4.2",
    "lucide-react": "1.21.0",
    "next-themes": "0.4.6",
    "nitro": "3.0.260610-beta",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
